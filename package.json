{
  "name": "olexpress",
  "private": true,
  "version": "1.0.0",
  "description": "OlexPress — Nyandarua-based ride-hailing service from Ol Kalou with 3D Galaxy globe, live tracking, driver dashboard, and ticket management.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "start": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ride-hailing",
    "react",
    "threejs",
    "leaflet",
    "kenya",
    "nyandarua",
    "ol-kalou",
    "vite"
  ],
